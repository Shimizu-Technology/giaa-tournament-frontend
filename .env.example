# Backend API URL
VITE_API_URL=http://localhost:3000

# Clerk Authentication (required only when VITE_SERVICE_MODE=live)
# Get your key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# PostHog Analytics (optional)
# VITE_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx
# VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# "live" enables the API-backed tournament app; "offseason" serves the static post-event page.
VITE_SERVICE_MODE=offseason
